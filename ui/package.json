{
  "name": "discourse-siwe-vue",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "check-bundle": "node scripts/check-bundle.mjs",
