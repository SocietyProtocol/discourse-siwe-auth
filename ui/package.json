    "@vueuse/core": "^14.3.0",
    "@wagmi/connectors": "8.2.0",
    "@wagmi/core": "3.6.5",
    "@wagmi/vue": "0.5.30",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "viem": "2.57.7",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "^6.0.3",
